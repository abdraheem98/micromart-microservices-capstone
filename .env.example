# Local development: shared SQLite database file, persistent across service restarts
DATABASE_URL=sqlite:///./micromart.db

# For Amazon RDS PostgreSQL, replace the value above with:
# DATABASE_URL=postgresql+psycopg://DB_USER:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/micromart

# Local Orders service setting (the EKS manifest uses Kubernetes DNS)
INVENTORY_URL=http://127.0.0.1:8002
